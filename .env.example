# API 管理员密钥（必填，用于 /admin/codes 接口）
ADMIN_KEY=your-secret-admin-key

# 生成的兑换码中包含的兑换页面地址（发送给买家的消息模板）
REDEEM_BASE_URL=https://your-domain.com

# API 地址（前端访问 API 用，生产环境通常为 /api 或完整域名）
NEXT_PUBLIC_API_BASE=https://your-domain.com/api

# ====================================================
# Replicate AI 图像生成（AI 精灵动作生成功能必填）
# 注册与 API Key：https://replicate.com/account/api-tokens
# 计费方式：按生成时间计费，约 $0.005-0.02/帧
# ====================================================

# Replicate API 令牌（必填，否则 AI 生成功能不可用）
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# img2img 基础生成模型（可选，默认 SDXL img2img）
# 可在 https://replicate.com/explore 搜索替换
REPLICATE_SPRITE_MODEL=stability-ai/sdxl:39ed52f2319f9c048d3054f925b6ccde6f6e9fddebb3d8a2cb09aac5fdb7e74f

# ControlNet 骨骼绑定模型（可选，默认 OpenPose ControlNet）
# 文档：https://replicate.com/jagilley/controlnet-pose
REPLICATE_CONTROLNET_MODEL=jagilley/controlnet-pose:0b558b6b3b77ea88e0d89eb96042699dc4eca25b26c33dff7cfab7b7eb98de3e

# ====================================================
# 拼多多开放平台配置（可选，不填则拼多多自动回复功能关闭）
# 开发者注册：https://open.pinduoduo.com/
# ====================================================
PINDUODUO_APP_ID=
PINDUODUO_APP_SECRET=
PINDUODUO_ACCESS_TOKEN=
