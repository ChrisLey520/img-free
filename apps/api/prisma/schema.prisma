generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model RedemptionCode {
  id           String    @id @default(cuid())
  code         String    @unique
  status       String    @default("UNUSED")
  resultPath   String?
  pddOrderId   String?
  remakesUsed  Int       @default(0)
  createdAt    DateTime  @default(now())
  usedAt       DateTime?
  expiresAt    DateTime?
}
